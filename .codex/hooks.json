{
  "description": "Record and immediately submit Codex prompts to the AI20K AI-usage log.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/_pyrun.sh scripts/log_hook.py --tool=codex --submit",
            "commandWindows": "venv\\Scripts\\python.exe scripts\\log_hook.py --tool=codex --submit",
            "timeout": 15,
            "async": true
          }
        ]
      }
    ]
  }
}
